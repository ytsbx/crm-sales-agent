        {"name": "check_foreign_currency_rejected.py", "args": ["{root}/ops/check_foreign_currency_rejected.py"], "local_order": 7, "ci_order": 15},
        {"name": "check_form_required_marks.py", "args": ["{root}/ops/check_form_required_marks.py"], "local_order": 8, "ci_order": 2},
