{
  "_instructions": "本地与CI共用检查项目；local_order和ci_order分别保留组内顺序。新增检查必须同时填写两边顺序。构建、浏览器、pytest和隔离数据库阶段由各入口管理；接口套件继续使用ops/check_suites.txt。",
  "groups": {
    "release-safety": {
      "cwd": {"local": ".", "ci": "."},
      "kind": "python",
      "checks": [
        {"name": "release_safety", "args": ["-m", "unittest", "discover", "-s", "ops/deploy", "-p", "test_release.py", "-v"], "local_order": 1, "ci_order": 1},
        {"name": "shared_check_runner", "args": ["-m", "unittest", "discover", "-s", "ops", "-p", "test_shared_checks.py", "-v"], "local_order": 2, "ci_order": 2}
      ]
    },
    "backend-static": {
      "cwd": {"local": "backend", "ci": "backend"},
      "kind": "python",
      "checks": [
        {"name": "pyflakes", "args": ["-m", "pyflakes", "app"], "local_order": 1, "ci_order": 1},
        {"name": "check_model_attrs", "args": ["scripts/check_model_attrs.py"], "local_order": 2, "ci_order": 2},
        {"name": "check_permissions", "args": ["scripts/check_permissions.py"], "local_order": 3, "ci_order": 3}
      ]
    },
    "backend-guards": {
      "cwd": {"local": "backend", "ci": "backend"},
      "kind": "python",
