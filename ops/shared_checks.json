        {"name": "check_registered_files.py", "args": ["scripts/check_registered_files.py"], "local_order": 1, "ci_order": 1},
        {"name": "check_output_criteria.py", "args": ["scripts/check_output_criteria.py"], "local_order": 2, "ci_order": 2},
