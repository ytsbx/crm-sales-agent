# 复制为 .env 后按本机情况修改。.env 不进版本库。
#
# 默认值对应仓库自带的 ops/docker-compose.yml（PostgreSQL 15 + Redis 7）。
# 先起中间件：docker compose -f ops/docker-compose.yml up -d

# 数据库：compose 里的 crm-postgres 映射到宿主机 5433（5432 已被别的项目占用）
DATABASE_URL=postgresql+asyncpg://crm:crm123456@127.0.0.1:5433/crm_sales_agent
# 若改用默认端口的 PostgreSQL，去掉端口即可：
#   postgresql+asyncpg://crm:crm123456@127.0.0.1:5432/crm_sales_agent
# 若要改用 MySQL（需要额外装 aiomysql）：
#   mysql+aiomysql://root:root123456@127.0.0.1:3306/crm_sales_agent

# Redis：compose 里的 crm-redis 映射到宿主机 6381，CRM 用 db 2 避免与别人撞库
REDIS_URL=redis://127.0.0.1:6381/2

# JWT 密钥：至少 32 字节；生产必须改，改动会让已发出的登录状态全部失效
JWT_SECRET=dev-only-secret-please-change-in-production-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 允许跨域的前端地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEBUG=true

# ===== Sales Agent（DeepSeek）=====
# 留空则 Agent 会提示"还没有配置模型"，其余功能不受影响
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 企业微信（PRD §8 / API §10）=====
# 全部留空即为"未配置"：同步接口会明确返回缺哪个变量，
# 不会静默返回"成功 0 条"。前端「企业微信」页也会列出缺哪些。
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 通讯录同步密钥（部门 / 成员）
WECOM_CONTACT_SECRET=
# 客户联系密钥（外部联系人）；企微里这是独立的一把，与通讯录密钥不同
WECOM_EXTERNAL_CONTACT_SECRET=
# 事件回调（企微要求公网 HTTPS）
# 回调地址填：https://<公网域名>/api/v1/webhooks/wecom/events
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
# 企微 API 基址，一般不用改
WECOM_API_BASE=https://qyapi.weixin.qq.com
# 单次同步最多翻多少页，防止配错时把对方接口打爆
WECOM_SYNC_MAX_PAGES=50

# ===== ERP / MES（API §28）=====
# 留空即"未配置"：推送接口返回 50203 并说明缺哪个变量，
# 且**不会**把订单标成已推送（否则 ERP 里没有单、CRM 却显示已同步）。
# provider 目前支持 jushuitan（聚水潭）；填别的值会走占位 Adapter（调用即报错）。
ERP_PROVIDER=
ERP_BASE_URL=
ERP_APP_KEY=
ERP_APP_SECRET=

# ---- 钉钉 OA 审批（文档 §11.3 :152 / 场景11）----
# 应用已在钉钉开放平台建好：CRM询价审批对接（AgentId 5035992137）。
# 注意两件事：
#   1) 权限勾选后必须去「版本管理与发布」**发布一版**才生效——不发布一律报无权限；
#   2) Client Secret 只放这里（.env 不入版本库），**不要贴到聊天/文档里**。
# 没配置时接口会明确报"钉钉未配置（缺 xxx）"，不会假装成功。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# 钉钉推送总闸：**默认关**（不填就是关）。测试期一条真实审批单都不发起。
# 要真发才设成 0——而且只对测试用的本人账号发，别对着真实业务发。
DINGTALK_PUSH_OFF=1
