# 复制为 .env 后按本机情况修改。.env 不进版本库。

# 数据库：默认用本机 Homebrew 的 PostgreSQL 15（已建专用账号 crm / 库 crm_sales_agent）
# 若要改用桌面知识库那套 Docker MySQL，换成：
#   mysql+aiomysql://root:root123456@127.0.0.1:3306/crm_sales_agent
DATABASE_URL=postgresql+asyncpg://crm:crm123456@127.0.0.1:5432/crm_sales_agent

# Redis：复用本机 Docker 中间件
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 密钥：至少 32 字节；生产必须改，改动会让已发出的登录状态全部失效
JWT_SECRET=dev-only-secret-please-change-in-production-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 允许跨域的前端地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEBUG=true

# ===== Sales Agent（DeepSeek）=====
# 与桌面「知识库」项目共用同一个 Key，留空则 Agent 处于未配置状态
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
